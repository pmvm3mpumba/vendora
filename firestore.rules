rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsProfile(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validPhone(value) {
      return value is string && value.matches('^[+][1-9][0-9]{7,14}$');
    }

    function validProfile(data) {
      return data.keys().hasAll([
          'name', 'email', 'phone', 'role', 'whatsappNumber',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'email', 'phone', 'role', 'whatsappNumber',
          'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string
        && data.email.size() > 0 && data.email.size() <= 254
        && validPhone(data.phone)
        && data.role in ['client', 'seller']
        && data.whatsappNumber is string
        && ((data.role == 'client' && data.whatsappNumber == '')
          || (data.role == 'seller' && validPhone(data.whatsappNumber)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{uid} {
      allow get: if ownsProfile(uid);
      allow list: if false;

      allow create: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Rôle, email et date de création ne sont pas modifiables ici.
      allow update: if ownsProfile(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'whatsappNumber', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // Référentiel public : uniquement les catégories actives.
    // La requête Flutter doit contenir where('isActive', isEqualTo: true).
    match /categories/{categoryId} {
      allow get, list: if resource.data.isActive == true;
      // Le référentiel est administré depuis la console, pas par les clients.
      allow create, update, delete: if false;
    }

    function isSeller() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'name', 'description', 'priceMinor', 'currency', 'categoryId',
          'stock', 'imageUrl', 'sellerId', 'sellerName',
          'sellerWhatsappNumber', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'description', 'priceMinor', 'currency', 'categoryId',
          'stock', 'imageUrl', 'sellerId', 'sellerName',
          'sellerWhatsappNumber', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 3000
        && data.priceMinor is int && data.priceMinor > 0
        && data.currency in ['BIF', 'USD', 'EUR']
        && data.categoryId is string && data.categoryId.matches('^[a-zA-Z0-9_-]{1,80}$')
        && data.stock is int && data.stock >= 0 && data.stock <= 1000000
        && data.imageUrl is string && data.imageUrl.matches('^https://[^ ]+$')
        && data.sellerId is string && data.sellerId == request.auth.uid
        && data.sellerName is string && data.sellerName.size() >= 2 && data.sellerName.size() <= 80
        && validPhone(data.sellerWhatsappNumber)
        && data.isActive is bool
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    // Catalogue public et création contrôlée par un vendeur.
    match /products/{productId} {
      allow get, list: if resource.data.isActive == true;
      allow create: if isSeller() && validProduct(request.resource.data);
      allow update, delete: if false;
    }

    // Les commandes restent fermées jusqu'à leur module sécurisé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
